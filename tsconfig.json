{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "noCheck": true
  },
  "include": [
    "api/**/*.ts",
    "config/**/*.ts",
    "api/**/*.js",
    "config/**/*.js"
  ]
}
